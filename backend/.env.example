# Copy this file to `.env` and fill in your own values before running the API.

# MongoDB connection string. For MongoDB Atlas it looks like:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# For a local MongoDB install, the default is usually fine as-is.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=shahi_angaar

# Used to sign admin login tokens. Change this to a long random string.
JWT_SECRET=change-this-to-a-long-random-string

# Default admin account created by seed.php (change the password after first login,
# see README.md for how to set a new one).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Angaar@2026

# Allow the Angular dev server (and later your real domain) to call this API.
CORS_ORIGIN=http://localhost:4200
